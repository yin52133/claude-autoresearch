{
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/autoresearch_session_start.py",
          "timeout": 10
        }
      ]
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/autoresearch_hooks_monitor.py",
          "timeout": 10
        }
      ]
    },
    {
      "event": "Stop",
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/autoresearch_stop_check.py",
          "timeout": 10
        }
      ]
    }
  ]
}
